@using ToolBox_MVC.Areas.LicenseManager.Models.DBModels
@using ToolBox_MVC.Repositories
@using ToolBox_MVC.Services.ActiveDirectory
@using ToolBox_MVC.Services.MFiles
@using ToolBox_MVC.Services.MFiles.Connector

@inject IServerRepository serverRepo;
@inject IADCredentialService adRepo;
@inject IGroupRepository groupRepository;
@inject IMfCredentialStore mfCredRepo;
@inject IMFilesService mfService;
@inject IGenericRepository<ActiveDirectory> adRepository;
@inject IAdService adService;

@model MFilesServer;

@{
    ViewData["Title"] = "Configuration M-Files";
    
}

<div class="d-inline-flex gap-3 flex-grow-0 content-header">
    <h1 class="align-middle">Configuration - Environnement : </h1>
    <form id="changeServer" asp-area="LicenseManager" asp-controller="Configuration" asp-action="Index" asp-route-serverName="" method="get">
        <a class="dropdown-toggle text-dark text-decoration-none clickable-text title" data-bs-toggle="dropdown" href="#">@Model.Name</a>
        <ul class="dropdown-menu">
            @{
                foreach (var server in await serverRepo.GetAllAsync())
                {
                    <li><a class="dropdown-item text-dark" asp-controller="Configuration" asp-action="Index" asp-route-serverName="@server.Name">@server.Name</a></li>
                }
            }
        </ul>
    </form>
</div>
<div class="config-grid">
    <form class="config-grid-item" method="post" asp-area="LicenseManager" asp-controller="Configuration" asp-action="ChangeMfServerInfos">
        @*Container for server infos*@
        <input type="hidden" asp-for="Id" />
        <div class="g-header">
            <h2>Infos de connexion au serveur M-Files</h2>
        </div>
        <div class="g-body">
            <div class="listView">
                <div class="list-item">
                    <div class="item-label">
                        Serveur 
                    </div>
                    <div class="item-value large">
                        <input class="form-control" asp-for="Name" value="@Model.Name" />
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        Adresse
                    </div>
                    <div class="item-value large">
                        <input class="form-control" asp-for="NetworkAddress" value="@Model.NetworkAddress" />
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        Protocole
                    </div>
                    <div class="item-value large">
                        <input class="form-control" asp-for="ProtocolSequence" value="@Model.ProtocolSequence" />
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        Endpoint
                    </div>
                    <div class="item-value large">
                        <input class="form-control" asp-for="EndPoint" value="@Model.EndPoint" />
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        GUID du Coffre
                    </div>
                    <div class="item-value large">
                        <input class="form-control" asp-for="VaultGuid" value="@Model.VaultGuid" />
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        État de la connexion
                    </div>
                    <div class="item-value large">
                        @{
                            var mfConnectionResults = mfService.TryServerConnection(Model.Id);

                            if (mfConnectionResults == MfConnexionResult.Success)
                            {
                                <span class="status active no-border">Connexion réussie</span>
                            }
                            else
                            {
                                <span class="status disabled no-border">
                                    @{
                                        switch (mfConnectionResults)
                                        {
                                            case MfConnexionResult.IncorrectInfos:
                                                <text>Informations de connexion invalides</text>
                                                break;
                                            case MfConnexionResult.IncorrectCredentials :
                                                <text>Identifiants invalides</text>
                                                break;
                                            default:
                                                <text>GUID du coffre invalide</text>
                                                break;
                                        }
                                    }
                                </span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="g-footer justify-content-end">
            <button type="submit" class="btn btn-primary">Sauvegarder</button>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#mfServerCred">Changer identifiant</button>
        </div>
    </form>
    <form class="config-grid-item double-row" asp-area="LicenseManager" asp-controller="Configuration">
        @*Container for M-Files groups list*@
        <div class="g-header">
            <h2>LicenseManager - Groupes M-Files</h2>
        </div>
        <div class="g-body">
            <div class="tableView area-wrapper">
                <div class="table-header">
                    <div class="table-cell check">
                        <input type="checkbox" id="account-select-all" onclick="checkAllAccountCheckBoxes()" />
                    </div>
                    <div class="table-cell">
                        Nom
                    </div>
                    <div class="table-cell maintained">
                        État
                    </div>
                </div>
                @{
                    var groupList = (await groupRepository.GetAllInServerAsync(Model.Id)).OrderByDescending(g => g.Maintained);
                    var lastMaintained = true;
                    foreach (var group in groupList)
                    {
                        if (lastMaintained && !group.Maintained)
                        {
                            <div class="table-group-seperator"></div>
                        }
                        lastMaintained = group.Maintained;
                        <div class="table-row">
                            <div class="table-cell check">
                                <input type="checkbox" class="account-check" name="@group.Name" value="true" onclick="updateViewSelectAll()" />
                            </div>
                            <div class="table-cell">
                                @group.Name
                            </div>
                            <div class="table-cell maintained">
                                @{
                                    if (group.Maintained)
                                    {
                                        <button type="submit" class="status active no-border clickable" asp-action="UnmaintainGroup" asp-route-serverId="@Model.Id" asp-route-groupId="@group.Id">
                                            Garder licences
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="status disabled no-border clickable" asp-action="MaintainGroup" asp-route-serverId="@Model.Id" asp-route-groupId="@group.Id">
                                            Retirer licences
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                    }
                }
                <div class="table-footer">
                    <div class="table-cell counter">
                        Nombre de comptes sélectionnés :<span class="selectionNumber">0</span>
                    </div>
                    <div class="table-cell buttons">
                        <button type="submit" disabled id="maintainSelection" class="selectionButton btn btn-primary" asp-action="MaintainSelection" asp-route-serverId="@Model.Id">Garder les licences</button>
                        <button type="submit" disabled id="unmaintainSelection" class="selectionButton btn btn-secondary" asp-action="UnmaintainSelection" asp-route-serverId="@Model.Id">Retirer les licences</button>
                    </div>
                </div>
            </div>
        </div>
    </form>
    <form class="config-grid-item" asp-area="LicenseManager" asp-controller="Configuration" asp-action="ChangeADInfos" asp-route-serverName="@Model.Name">
        <input type="hidden" asp-for="Name" value="@Model.Name" />
        <input type="hidden" asp-for="Id" value="@Model.Id" />
        <div class="g-header">
            <h2>Infos de connexion à l'Active Directory</h2>
        </div>
        @*Container for AD infos*@
        @{
            var adList = await adRepository.GetAllAsync();
        }
        <div class="g-body">
            <div class="listView">
                <div class="list-item">
                    <div class="item-label">
                        Adresse du domaine
                    </div>
                    <div class="item-value large">
                        <select class="form-select" asp-for="ActiveDirectoryID">
                            @{
                                foreach (var ad in adList)
                                {
                                    if (ad.ID == Model.ActiveDirectoryID)
                                    {
                                        <option selected value="@ad.ID">@ad.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@ad.ID">@ad.Name</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        État de la connexion
                    </div>
                    <div class="item-value large">
                        @{
                            var adConnectResults = adService.TryConnection(Model.ActiveDirectoryID);
                            if (adConnectResults == ADConnectionResult.Success)
                            {
                                <span class="status active no-border">Connexion Réussie</span>
                            }
                            else
                            {
                                <span class="status disabled no-border">
                                    @{
                                        if (adConnectResults == ADConnectionResult.Failed)
                                        {
                                            <text>Connexion échouée, vérifiez les informations de connexion</text>
                                        }
                                        else
                                        {
                                            <text>Connexion échouée, identifiants de connexions invalides</text>
                                        }
                                    }
                                </span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <div class="g-footer justify-content-end">
            <button type="submit" class="btn btn-primary">Sauvegarder</button>
            <button type="button" class="btn btn-secondary" data-bs-toggle="modal" data-bs-target="#adCred">Changer identifiant</button>
        </div>
    </form>

    <form method="post" asp-area="LicenseManager" asp-controller="Configuration" asp-action="ChangeAutoParameters" class="config-grid-item">
        <div class="g-header">
            <h2>Automatisation et synchronisation</h2>
        </div>
        @*Container for sync settings*@
        <div class="g-body">
            <input type="hidden" asp-for="Id" value="@Model.Id"/>
            <div class="listView area-wrapper">
                <div class="list-item">
                    <div class="item-label">
                        Heure de synchronisation
                    </div>
                    <div class="item-value">
                        <input type="time" asp-for="SyncTime" value="@Model.SyncTime" />
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        LM - Retrait automatique
                    </div>
                    <div class="item-value">
                        <input asp-for="AutomaticOP.AutoRemove">
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        LM - Restauration automatique
                    </div>
                    <div class="item-value">
                        <input asp-for="AutomaticOP.AutoRestore">
                    </div>
                </div>
                <div class="list-item">
                    <div class="item-label">
                        Cohérence entre état actif AD et état actif M-Files
                    </div>
                    <div class="item-value">
                        <input asp-for="AutomaticOP.AutoActivationHandling">
                    </div>
                </div>
            </div>
        </div>
        <div class="g-footer justify-content-end">
            <button type="submit" class="btn btn-primary">Sauvegarder</button>
        </div>
    </form>
</div>

@*Boîtes modales*@
@{
    var mfCredentials = new MFilesCredential();
    mfCredentials.EncryptedUserName = string.Empty;
    mfCredentials.EncryptedPassword = string.Empty;
}
<div class="modal fade" id="mfServerCred" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <form method="post" asp-area="LicenseManager" asp-controller="Configuration" asp-action="ChangeMfCredentials" asp-route-serverId="@Model.Id" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Changement identifiants M-Files</h5>
                <button type="button" class="btn-close b-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="listView">
                    <div class="list-item">
                        <div class="item-label">
                            Nom d'utilisateur
                        </div>
                        <div class="item-value">
                            <input class="form-control" asp-for="@mfCredentials.EncryptedUserName" type="text" required/>
                        </div>
                    </div>
                    <div class="list-item">
                        <div class="item-label">
                            Mot de passe
                        </div>
                        <div class="item-value">
                            <input class="form-control" asp-for="@mfCredentials.EncryptedPassword" type="password" required />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-end">
                <button class="btn btn-primary" type="submit">Sauvegarder</button>
            </div>
        </form>
    </div>
</div>

@{
    ActiveDirectory activeDirectory = new();
}
<div class="modal fade" id="adCred" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <form method="post" asp-area="LicenseManager" asp-controller="Configuration" asp-action="ChangeAdCredentials" asp-route-serverName="@Model.Name" class="modal-content">
            <input type="hidden" asp-for="@activeDirectory.ID" value="@Model.ActiveDirectory.ID" />
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLongTitle">Changement identifiants Active Directory</h5>
                <button type="button" class="btn-close b-0" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="listView">
                    <div class="list-item">
                        <div class="item-label">
                            Nom d'utilisateur
                        </div>
                        <div class="item-value">
                            <input class="form-control" asp-for="@activeDirectory.EncryptedCredentials.Username" type="text" required />
                        </div>
                    </div>
                    <div class="list-item">
                        <div class="item-label">
                            Mot de passe
                        </div>
                        <div class="item-value">
                            <input class="form-control" asp-for="@activeDirectory.EncryptedCredentials.Password" type="password" required />
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-end">
                <button class="btn btn-primary" type="submit">Sauvegarder</button>
            </div>
        </form>
    </div>
</div>
